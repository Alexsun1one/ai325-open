# ai325 后端环境变量（复制为 .env 并填值；.env 永不入仓）

# —— 必需 ——
# 数据目录（SQLite 自动建库）
XF_DATA_DIR=/data
# 静态文件目录（SPA 兜底；可指向 site/out）
XF_STATIC_DIR=/app/static
# 首次启动管理员密码（必填：启动即 PBKDF2 哈希入库，之后改密码走站内）
INITIAL_ADMIN_PASS=change-me

# —— 可选 ——
# 注册邀请码（留空则关闭邀请码校验）
INVITE_CODE=
# 管理端点口令（留空则回退用 INITIAL_ADMIN_PASS 校验）
ADMIN_AUTH=
# Hermes 蒸馏用（hermes/ledger 与 harness 步；不入日志不回显）
DEEPSEEK_API_KEY=
# 跳过守门 worker（本地开发调试用）
XF_SKIP_GATEKEEPER_WORKER=0
